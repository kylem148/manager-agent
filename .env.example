# ---------------------------------------------------------------------------
# Co-manager configuration. Copy to .env (in cwd) or ~/co-managers/.env.
# Everything here can also be set as a real environment variable.
# ---------------------------------------------------------------------------

# --- Bedrock / model backend (required) ---
# AWS region that serves your Claude models on Bedrock.
AWS_REGION=us-west-2

# Model to use. Default is Opus 5 on the US geo inference profile.
# On Bedrock this must be an inference-profile id, not a bare foundation id: the
# bare `anthropic.claude-opus-5` is rejected for on-demand throughput. Served by
# the standard Bedrock runtime path, not the newer Mantle endpoint (our Bedrock
# key isn't entitled to Mantle).
#
# `global.` vs `us.` looks like a 10% saving and measured as a 25% loss — see
# the "Endpoint" section below before changing it.
#
# Cheaper alternatives verified on this account, if cost outranks capability:
#   us.anthropic.claude-sonnet-5       ~40% of Opus per token, keeps xhigh
#   us.anthropic.claude-sonnet-4-6     cheapest; does NOT accept effort=xhigh
BEDROCK_MODEL_ID=us.anthropic.claude-opus-5

# --- Auth (bearer token preferred) ---
# Preferred auth path, matching Claude Code. Paste your Bedrock bearer token
# here — or run `co auth bedrock`, which writes it to ~/co-managers/.env with
# 0600 permissions for you. Resolution order: AWS_BEARER_TOKEN_BEDROCK, then
# BEDROCK_API_KEY, then standard AWS credentials (SigV4) below.
AWS_BEARER_TOKEN_BEDROCK=

# Alias also accepted:
# BEDROCK_API_KEY=

# Fallback only: standard AWS credentials (SigV4-sign requests when no bearer
# token is set). Also works via ~/.aws/credentials or an SSO profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Run `co doctor --models` to confirm which models answer on your auth path.

# Response sizing / reasoning
# Ceiling on tokens per reply; thinking and the visible answer share it. Streaming
# is always on, so a large ceiling is safe (it is a cap, not a target). Raise to
# 64000 for heavier agentic turns.
CO_MAX_TOKENS=32000
# adaptive | off. Default adaptive. Opus 4.8 runs WITHOUT thinking unless it is
# explicitly asked for, and adaptive is its only accepted on-mode. Set to off to
# disable reasoning entirely.
CO_THINKING=adaptive
# low | medium | high | xhigh | max. Controls thinking depth and token spend --
# and not just thinking: it governs all output, so lower effort also means fewer,
# more consolidated tool calls, and every tool call is another round trip.
# Default high, which is what Anthropic recommends for Opus 4.8 on
# intelligence-sensitive work; xhigh is aimed at coding and agentic use, which a
# co-manager is not. Raise it when you want more rigor and will wait for it.
# This is the default a session starts at; /effort <level> overrides it for the
# rest of that session.
#
# The ladder is per-model. `xhigh` arrived with Opus 4.7, so it is fine here but
# 400s on Sonnet 4.6 / Opus 4.6 -- set it there and comanager quietly runs `high`
# instead rather than failing every turn; /effort says so outright.
CO_EFFORT=high

# true to print per-round latency and token/cache counters into the transcript:
#   round 1: 1.2s (first token 1.2s) · in 2 cache+199/read 8394 · out 7 · stop end_turn
# Off by default. `read` is the number of prompt tokens served from cache; if it
# stays at 0 across turns of one session, prompt caching has stopped working and
# every turn is paying full price to reprocess the system prompt and history.
# This is a per-round diagnostic, not the spend meter: token and dollar totals
# are always accumulated regardless of this setting, and `/cost` shows them.
# CO_DEBUG_TIMING=true

# --- Endpoint: global vs geo (measured, and it went the other way) ---
# On paper global wins: Anthropic documents a 10% premium on Bedrock's geo
# endpoints over global, on every token class, for the same model.
#
# It did not hold here. Measured over 71 real turns on global against 152 on us.:
#
#   cache write per turn   11,026  ->  37,151   (3.4x)
#   rebuilds as a share of all writes:  85%
#   cost per turn          $0.428  ->  $0.536   (+25%)
#
# Rebuilds are writes billed on a turn's OPENING round, so 85% means the prefix
# was rebuilt at the start of nearly every turn — on a 38-second average gap
# against a one-hour TTL. No expiry explains that. AWS warns cross-region
# inference "may lead to increased cache writes", and global routes across the
# widest pool there is, so a request can land where the cache is not.
#
# A 10% list-price saving is worth nothing against a 20:1 write-to-read spread.
# If you try global again, the `rebuilds` line in /cost is the thing to watch.
# BEDROCK_MODEL_ID=us.anthropic.claude-opus-5       # default
# BEDROCK_MODEL_ID=global.anthropic.claude-opus-5   # -10% list, +25% measured

# --- Per-instance overrides ---
# An instance may pin its own model in `instances/<name>/.env`, which is how you
# A/B a cheaper tier against a control rather than guessing from one blended
# number. Only these keys are read there: BEDROCK_MODEL_ID, CO_EFFORT,
# CO_THINKING, CO_MAX_TOKENS.
#
# Precedence: this file < instances/<name>/.env < real environment variables.
# Delete the instance file to hand control back here.
#
# `/model <id>` inside a session writes BEDROCK_MODEL_ID there for you, after
# checking with Bedrock that the id answers. `/model` alone says which rung of
# that ladder is currently winning — including when an exported variable is
# covering a stored choice, in which case /model refuses to set one.

# --- Cache keep-alive ---
# Bedrock restarts a cache entry's TTL on every successful hit, and a hit is
# billed at a tenth of base input while a 1-hour write is billed at double it.
# So touching the cached prefix costs a TWENTIETH of rebuilding it, and an entry
# that keeps being touched never has to be rebuilt at all.
#
# That matters here more than in most apps: a co-manager is a thinking partner,
# so the captain reads an answer, thinks, and comes back much later. Every pause
# that outlives the TTL bills the whole prefix at the premium rate on the next
# turn. An idle session therefore touches its own cache on a timer.
#
# The interval must stay comfortably inside CACHE_TTL in model.ts (currently 1h):
# a probe that lands late pays the rebuild it existed to prevent, so early is
# free and late is the entire cost. Probes are metered in `/cost` as their own
# line, apart from turns, so the trade can be audited rather than assumed.
# CO_CACHE_KEEPALIVE=off          # disable entirely
# CO_CACHE_KEEPALIVE_MS=2700000   # how long idle before touching the cache (45m)
# CO_CACHE_KEEPALIVE_MAX=3        # probes in a row before deciding you've left

# --- History compaction ---
# The conversation grows every turn and all of it is re-sent on every round, so
# cost per turn climbs for the life of a session. Past this many estimated tokens
# the co summarises the older part of the conversation and keeps only the recent
# exchanges verbatim.
#
# The ceiling is deliberately high and a normal session should never reach it.
# Compacting trades cheap reads for expensive writes — a cached read is a
# twentieth the price of a write, and every compaction rewrites the retained
# tail — so on measured sessions of this app's typical length, compacting eagerly
# costs MORE than leaving the history alone. This is a guard against the session
# left open all day, not routine housekeeping.
#
# Nothing is lost: the transcript is written every turn and the logs are
# append-only and searchable, so detail leaves the live window, not the disk.
# CO_COMPACT=off                  # disable entirely
# CO_COMPACT_AT_TOKENS=60000      # ceiling before the older history is summarised
# CO_COMPACT_KEEP_TURNS=6         # recent exchanges always kept verbatim

# --- Terminal UX ---
# Interactive sessions run as a scrollable full-screen UI on a real TTY (alt
# screen buffer, like claude/vim/less), with its own transcript scrollback via
# the mouse wheel and PgUp/PgDn. To scroll, the app captures the mouse; hold
# your terminal's override key (Option/Fn/Shift) to select text natively.
# Set CO_MOUSE=off to disable mouse capture entirely: the wheel stops scrolling
# the transcript (use PgUp/PgDn), but native click-drag selection always works.
# CO_MOUSE=off
# Pasting a multi-line block collapses it to a "[Pasted text #1 +43 lines]" chip
# (the full text is sent on submit) via bracketed paste. Set CO_PASTE=off if your
# terminal doesn't support it and raw paste markers leak into the input.
# CO_PASTE=off
# Shift+Enter inserts a newline instead of sending the message. It only works if
# the terminal can report it, so the app asks for the Kitty keyboard protocol on
# startup (and disables it again on exit). Set CO_KEYS=off to skip that request:
# you lose Shift+Enter, but Ctrl-J always inserts a newline on any terminal.
# CO_KEYS=off
# full | minimal | off. Two small nautical animations, on by default: waves roll
# out under the destination branch when a confirmed order fires, and a ship sails
# the width once while memory saves on /exit. Both play only during an idle wait,
# never while the model is streaming, and both are decoration over a line that is
# printed either way. 'minimal' keeps the line and its glyphs but never moves;
# 'off' is a plain ASCII line. The environment can only lower this: NO_COLOR, a
# pipe, TERM=dumb, a terminal under 40 columns, or a reduced-motion signal
# (CO_REDUCED_MOTION / REDUCED_MOTION / PREFERS_REDUCED_MOTION / NO_MOTION) all
# fall back to the plain ASCII line on their own.
# CO_VISUALS=off

# --- Memory workspace ---
# Root folder for all co-manager instances. Defaults to ~/co-managers.
# CO_HOME=/Users/you/co-managers

# --- Crew dispatch ---
# Dispatch is configured per instance with `co link` (repo path, agent command
# template, safety caps, pane layout), NOT here: it isn't secret and it differs
# per instance, so it lives in <instance>/.dispatch/config.json. There is nothing
# to set in this file for dispatch.

# --- Research layer (all optional) ---
# Search provider selection: auto | exa | brave | tavily | searxng | none
# 'auto' prefers Exa, then Brave, Tavily, SearXNG - whichever has credentials.
CO_SEARCH_PROVIDER=auto
# EXA_API_KEY=
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SEARXNG_URL=http://localhost:8080

# Fetcher: Jina Reader turns any URL into clean markdown (free, no key needed).
# Set a key only if you have one (higher rate limits).
CO_FETCH_JINA=true
# JINA_API_KEY=
CO_FETCH_MAX_CHARS=12000
